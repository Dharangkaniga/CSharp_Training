@model MVC_Q1.Models.Customer

@{
    ViewBag.Title = "Customer Details";
}

<h2>Customer Details for Order ID 10248</h2>

@if (Model != null)
{
    <table border="1" cellpadding="8">

        <tr>
            <td>Customer ID</td>
            <td>@Model.CustomerID</td>
        </tr>

        <tr>
            <td>Company Name</td>
            <td>@Model.CompanyName</td>
        </tr>

        <tr>
            <td>Contact Name</td>
            <td>@Model.ContactName</td>
        </tr>

        <tr>
            <td>Address</td>
            <td>@Model.Address</td>
        </tr>

        <tr>
            <td>City</td>
            <td>@Model.City</td>
        </tr>

        <tr>
            <td>Country</td>
            <td>@Model.Country</td>
        </tr>

        <tr>
            <td>Phone</td>
            <td>@Model.Phone</td>
        </tr>

    </table>
}
else
{
    <h3>No customer found for Order ID 10248</h3>
}