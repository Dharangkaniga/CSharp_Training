@model MVC_Q2.Models.Movie

<h2>Delete Movie</h2>

<h3>Are you sure you want to delete this movie?</h3>

<table border="1">
    <tr>
        <td>Movie Name</td>
        <td>@Model.MovieName</td>
    </tr>

    <tr>
        <td>Director</td>
        <td>@Model.DirectorName</td>
    </tr>

    <tr>
        <td>Date</td>
        <td>@Model.DateOfRelease</td>
    </tr>
</table>

@using (Html.BeginForm())
{
    @Html.HiddenFor(m => m.Mid)
    <input type="submit" value="Delete" />
}